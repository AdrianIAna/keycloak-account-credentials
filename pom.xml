<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.sinenomine.keycloak</groupId>
    <artifactId>keycloak-account-credentials</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>Keycloak Account Credentials SPI</name>
    <description>
        Keycloak extension serving a user's own credential inventory (types,
        labels, creation dates - never secrets) at
        /realms/{realm}/account-credentials/me, and self-scoped credential
        removal at DELETE /realms/{realm}/account-credentials/{id}, authorized
        by the caller's own account access token - no admin credentials
        required. Unlike the built-in Account REST API's credentials endpoint,
        the listing does not depend on which authenticators the realm's flows
        reference, so credential types managed by custom authenticators (e.g.
        passkey-first flows) are reported truthfully - and become removable.
    </description>
    <url>https://github.com/AdrianIAna/keycloak-account-credentials</url>

    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Sine Nomine Associates</name>
        <url>https://www.sinenomine.net</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Adrian Ana</name>
            <email>aana@sinenomine.net</email>
            <organization>Sine Nomine Associates</organization>
            <organizationUrl>https://www.sinenomine.net</organizationUrl>
        </developer>
    </developers>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <keycloak.version>26.7.2</keycloak.version>
        <jakarta.ws.rs.version>3.1.0</jakarta.ws.rs.version>
        <junit.version>6.1.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.keycloak</groupId>
                <artifactId>keycloak-parent</artifactId>
                <version>${keycloak.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- All Keycloak runtime SPIs are provided (already on the server classpath) -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JAX-RS annotations (provided by RESTEasy on the server) -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- @NoCache annotation (provided - Keycloak's Quarkus REST runtime processes it) -->
        <dependency>
            <groupId>io.quarkus.resteasy.reactive</groupId>
            <artifactId>resteasy-reactive-common</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Logging (provided, version managed by Keycloak BOM) -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Provides a JAX-RS RuntimeDelegate so WebApplicationException subclasses
             (401/403/404) can be constructed under test. Test scope only;
             version managed by the Keycloak BOM. -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              The default source directory MUST stay declared: naming <resources>
              at all overrides it, and dropping it would silently stop packaging
              META-INF/services, leaving an inert provider JAR that still builds.
              PackagedJarIT pins both halves.
            -->
            <!-- Apache-2.0 4(d): ship LICENSE and NOTICE inside the artifact,
                 not just at the repo root, so they reach whoever takes the jar. -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <systemPropertyVariables>
                        <packaged.jar>${project.build.directory}/${project.build.finalName}.jar</packaged.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
